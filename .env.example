# Plantilla de variables de entorno. Copiar a `.env` y cambiar los valores.
# Nunca subir `.env` al repositorio.

# --- CouchDB ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=cambiar-esta-contrasena
COUCHDB_PORT=15984
COUCHDB_URL=http://localhost:15984

# Usuarios de aplicación que crea `infra/couchdb/setup.sh`.
BACKEND_PASSWORD=cambiar-backend

CLIENTE_PASSWORD=cambiar-cliente

# --- API Rust ---
PORT=3000
# `activo` exige login real; `desactivado` usa el usuario falso con rol encargado.
AUTH_MODE=desactivado
JWT_SECRET=cambiar-este-secreto
