# Plantilla de variables de entorno. Copiar a `.env` y cambiar los valores.
# Nunca subir `.env` al repositorio.

# --- CouchDB ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=cambiar-esta-contrasena
COUCHDB_PORT=15984
COUCHDB_URL=http://localhost:15984

# Usuarios de aplicación que crea `infra/couchdb/setup.sh`.
BACKEND_USER=backend
BACKEND_PASSWORD=cambiar-backend
CLIENTE_PASSWORD=cambiar-cliente

# Usuarios que pueden iniciar sesión en la API (base `usuarios`).
# La contraseña solo se guarda como hash Argon2id.
CAJERO_USUARIO=cajero1
CAJERO_PASSWORD=cambiar-cajero
ENCARGADO_USUARIO=encargado1
ENCARGADO_PASSWORD=cambiar-encargado

# --- API Rust ---
PORT=3000
# `activo` exige login real; `desactivado` usa el usuario falso con rol encargado.
AUTH_MODE=activo
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio

# Orígenes del navegador autorizados por CORS, separados por coma.
# En el servidor agrega el dominio real del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
